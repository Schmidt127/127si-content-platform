NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# When true, admin routes require app_metadata.content_admin and publish via set_content_status (0008).
# Leave unset/false until 0008 is applied and admins have content_admin assigned (see docs/secure-publishing-rollout.md).
CONTENT_SECURE_PUBLISHING=
